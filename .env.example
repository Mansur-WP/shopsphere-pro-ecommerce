# ==========================================
# REQUIRED FOR STAGING DEPLOYMENT ON VERCEL
# ==========================================

# 1. Database (Hosted PostgreSQL, e.g. Neon, Supabase, Railway, Vercel Postgres)
# Server-only secret
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Authentication (NextAuth v5 / Auth.js)
# Server-only secrets
AUTH_SECRET="your-32-character-secret-generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="your-32-character-secret-generate-with-openssl-rand-base64-32"
# Server & Client safe base URL
NEXTAUTH_URL="https://your-staging-app.vercel.app"

# 3. Application Public Base URL
# Client-safe variable
NEXT_PUBLIC_APP_URL="https://your-staging-app.vercel.app"

# ==========================================
# OPTIONAL INTEGRATIONS FOR STAGING
# ==========================================

# OAuth Providers (Optional)
# Server-only secrets
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Cloudinary Image Storage (Optional — image URLs fallback to public URLs if empty)
# Server-only secrets
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Client-safe Cloudinary variables
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Resend Email Delivery (Optional — logs emails to console in demo mode if key is missing)
# Server-only secret
RESEND_API_KEY=""
EMAIL_FROM="Africhina Connect <onboarding@resend.dev>"

# Stripe / Payments (Optional — demo checkout mode works without keys)
# Server-only secret
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Client-safe public key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

